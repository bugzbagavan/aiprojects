# BugScribe — Azure DevOps integration
#
# Copy this file to `.env` (same directory) and fill in the real values
# before running `npm run build` / `npm run dev`. Values are injected into
# the bundle at build time via webpack.DefinePlugin — `.env` itself is
# git-ignored so credentials never leave your machine.

# Personal Access Token with at least these scopes:
#   - Work Items: Read & Write
# Create one at: https://dev.azure.com/<your-org>/_usersSettings/tokens
AZURE_PAT=your_personal_access_token_here

# Organization URL, no trailing slash.
# Example: https://dev.azure.com/contoso
AZURE_ORG_URL=https://dev.azure.com/your-organization

# Name of the Azure DevOps project where bugs should be created.
AZURE_PROJECT=your-project-name
